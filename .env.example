# Backend API base URL
# Development: http://127.0.0.1:8000/api
# Production: https://your-backend-domain.com/api
NUXT_PUBLIC_API_BASE=https://api.bytestacklab.com/api

# Canonical site URL — used for the sitemap and SEO meta tags
NUXT_PUBLIC_SITE_URL=https://bytestacklab.com

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXX).
# Leave empty to skip loading GA entirely.
NUXT_PUBLIC_GA_ID=

# Optional — YouTube ID of the company intro video (the part after ?v=).
# Leave empty and the hero omits the play button entirely, which is the
# correct behaviour until a real ByteStackLab video exists.
NUXT_PUBLIC_INTRO_VIDEO_ID=

# Vercel ISR on-demand revalidation secret (NOT a NUXT_PUBLIC_ var — must stay
# server-side). Not used locally; only needs to be set as a real Vercel
# project env var (Production, build-time) so nuxt.config.ts's
# `nitro.vercel.config.bypassToken` can bake it into the deployed prerender
# functions for '/' and '/case-studies/**'. The exact same value must also be
# set as VERCEL_BYPASS_TOKEN in the backend's .env — see
# ByteStackLab-Backend/app/Jobs/RevalidateFrontendCache.php.
VERCEL_BYPASS_TOKEN=
